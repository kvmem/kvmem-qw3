# Copy to benchmark/manifest.env and adjust paths before running benchmark scripts.
#
#   cp benchmark/manifest.env.example benchmark/manifest.env

# Core binaries and model
QW3=./build/qw3
MODEL=models/Qwen3.6-27B-Q8_0.gguf
LLAMA_COMPLETION=/path/to/llama-completion

# Serving defaults (efficiency + accuracy)
CTX=262144
PREFILL_CHUNK=2048
KV_DTYPE=fp16
KV_POOL_PAGES=49152
SERVE_HOST=127.0.0.1
SERVE_PORT=8080

# Benchmark timeouts (seconds)
SMOKE_TIMEOUT=900
EFFICIENCY_TIMEOUT=3600
ACCURACY_TIMEOUT=7200

# Result root override (optional). When empty, scripts pick:
# benchmark/results/<git-sha>_<timestamp>/
RESULT_ROOT=

# Python venv for lm_eval (accuracy script)
VENV_ACTIVATE=.venv/bin/activate
